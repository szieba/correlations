Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"In", " ", "NuFIT", " ", "datasets", " ", 
     SubscriptBox["\[Delta]", "CP"], " ", 
     RowBox[{"(", "DCP", ")"}], " ", "is", " ", "given", " ", "in"}], " ", "-", 
    RowBox[{"180", "\[Degree]", " ", "to"}], " ", "+", 
    RowBox[{"180", "\[Degree]", " ", "range", " ", "and", " ", 
     SubsuperscriptBox["\[CapitalDelta]m", "21", "2"], " ", 
     RowBox[{"(", "DMS", ")"}], "is", " ", "given", " ", "as", " ", "Log", 
     RowBox[{
      RowBox[{"(", 
       SubsuperscriptBox["\[CapitalDelta]m", "21", "2"], ")"}], ".", " ", 
      "\[IndentingNewLine]", "For"}], " ", "the", " ", "details", " ", 
     "refer", " ", 
     RowBox[{"to", ":", " ", "http", ":"}]}]}], "//", 
   RowBox[{
    RowBox[{"www", ".", "nu"}], "-", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{"fit", ".", "org"}], "/", "sites"}], "/", "default"}], "/", 
      "files"}], "/", 
     RowBox[{"v61", ".", "release"}]}], "-", 
    RowBox[{"notes", ".", "pdf"}]}]}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"Applied", " ", 
    RowBox[{
    "transformations", " ", ":", "     ", "\[IndentingNewLine]", 
     "\[IndentingNewLine]", "DCP", " ", ":", " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"-", "180"}], ",", " ", "180"}], ")"}]}]}], " ", "->", " ", 
   RowBox[{"(", 
    RowBox[{"0", ",", " ", "360"}], ")"}]}], " "}], "\[IndentingNewLine]", 
 RowBox[{"\t  ", 
  RowBox[{
   RowBox[{"DMS", " ", ":", " ", 
    RowBox[{"Log", 
     RowBox[{"(", "DMS", ")"}]}]}], " ", "->", " ", 
   RowBox[{"DMS", "/", 
    RowBox[{"10", "^", 
     RowBox[{"-", "5"}]}]}]}], "   ", "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{" ", 
  RowBox[{
   RowBox[{"The", " ", "convention", " ", 
    RowBox[{
    "is", ":", "\[IndentingNewLine]", "\[IndentingNewLine]", "T13", " ", ":", 
     " ", 
     RowBox[{
      SuperscriptBox["sin", "2"], 
      RowBox[{
       SubscriptBox["\[Theta]", "13"], " ", "/", " ", 
       SuperscriptBox["10", 
        RowBox[{"-", "2"}]]}]}]}]}], ",", "\[IndentingNewLine]", "     ", 
   RowBox[{"T12", " ", ":", " ", 
    RowBox[{
     SuperscriptBox["sin", "2"], 
     RowBox[{
      SubscriptBox["\[Theta]", "12"], " ", "/", " ", 
      SuperscriptBox["10", 
       RowBox[{"-", "1"}]]}]}]}], ",", "\[IndentingNewLine]", "     ", 
   RowBox[{"T23", " ", ":", " ", 
    RowBox[{
     SuperscriptBox["sin", "2"], 
     RowBox[{
      SubscriptBox["\[Theta]", "23"], " ", "/", " ", 
      SuperscriptBox["10", 
       RowBox[{"-", "1"}]]}]}]}], ",", "\[IndentingNewLine]", "     ", 
   RowBox[{"DCP", " ", ":", " ", 
    RowBox[{
     SubscriptBox["\[Delta]", "CP"], " ", "/", " ", "\[Degree]"}]}], ",", 
   "\[IndentingNewLine]", "     ", 
   RowBox[{"DMS", " ", ":", " ", 
    RowBox[{
     RowBox[{
      SubsuperscriptBox["\[CapitalDelta]m", "21", "2"], " ", "/", " ", 
      SuperscriptBox["10", 
       RowBox[{"-", "5"}]]}], " ", 
     SuperscriptBox["eV", "2"]}]}], ",", "\[IndentingNewLine]", "     ", 
   RowBox[{"DMA", " ", ":", " ", 
