Cell[BoxData[
 RowBox[{
  RowBox[{"nufitdatapos", "=", 
   RowBox[{"Append", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"(", 
       RowBox[{"DeleteDuplicates", "[", 
        RowBox[{
         RowBox[{"Position", "[", 
          RowBox[{"nufitdatatabno", ",", 
           RowBox[{"_", "?", "StringQ"}]}], "]"}], "[", 
         RowBox[{"[", 
          RowBox[{";;", ",", "1"}], "]"}], "]"}], "]"}], ")"}], "[", 
      RowBox[{"[", 
       RowBox[{"2", ";;"}], "]"}], "]"}], ",", 
     RowBox[{
      RowBox[{"Length", "[", "nufitdatatabno", "]"}], "+", "1"}]}], "]"}]}], 
  ";"}]], "Input",
 CellChangeTimes->{{3.953997914437828*^9, 3.953997920150652*^9}, {
   3.953997951229723*^9, 3.953997992207735*^9}, 3.9539983985273457`*^9, {
