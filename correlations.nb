Cell[TextData[{
 "\n",
 StyleBox["NOTE:",
  FontWeight->"Bold",
  FontVariations->{"Underline"->True}],
 "\nBefore running the remaining notebook cells, ensure that the datasets \
directory has been created and the required data files have been downloaded \
and extracted. \nThis can be done manually, or by uncommenting and running \
the cell below (under Linux) to download and extract the NuFIT v6.1 data \
files."
}], "Text",
