Cell[BoxData[
 RowBox[{"Plot", "[", "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{"Min", "[", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{"Min", "[", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"chisqtilde", "[", 
          RowBox[{
           RowBox[{"{", 
            
            RowBox[{"\"\<T23\>\"", ",", "\"\<T13\>\"", ",", "\"\<DCP\>\"", 
             ",", "\"\<T12\>\""}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{"s23sq", ",", "s13sq", ",", 
             RowBox[{"360", "-", 
              RowBox[{
               RowBox[{
                RowBox[{"ArcCos", "[", 
                 RowBox[{"cosdcptm1", "[", 
                  RowBox[{"s23sq", ",", "s13sq"}], "]"}], "]"}], "/", "Pi"}], 
               "*", "180"}]}], ",", 
             RowBox[{"s12sqtm1", "[", "s13sq", "]"}]}], "}"}], ",", 
           "nufitfintio"}], "]"}], ",", "\[IndentingNewLine]", 
         RowBox[{"chisqtilde", "[", 
          RowBox[{
           RowBox[{"{", 
            
