Cell[BoxData[
 RowBox[{
  RowBox[{"nufitcoreln", "=", 
   RowBox[{"StringSplit", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"(", 
       RowBox[{
        RowBox[{
         RowBox[{"nufitdatatabno", "[", 
          RowBox[{"[", "#", "]"}], "]"}], "  ", "&"}], " ", "/@", " ", 
        RowBox[{"nufitdatapos", "[", 
         RowBox[{"[", 
          RowBox[{";;", 
           RowBox[{"-", "2"}]}], "]"}], "]"}]}], " ", ")"}], "[", 
