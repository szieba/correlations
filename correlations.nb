Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"cosdcptm1", "[", 
    RowBox[{"s23sqvar_", ",", "s13sqvar_"}], "]"}], ":=", 
   RowBox[{
    RowBox[{
     RowBox[{"(", 
      RowBox[{"1", "-", 
       RowBox[{"5", 
        RowBox[{"s13var", "^", "2"}]}]}], ")"}], 
     RowBox[{
      RowBox[{"(", 
       RowBox[{
        RowBox[{"2", " ", 
         RowBox[{"s23var", "^", "2"}]}], "-", "1"}], ")"}], "/", 
      RowBox[{"(", 
       RowBox[{"4", "s13var", "*", "s23var", "*", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{"2", 
           RowBox[{"(", 
            RowBox[{"1", "-", 
             RowBox[{"3", 
              RowBox[{"s13var", "^", "2"}]}]}], ")"}], 
           RowBox[{"(", 
            RowBox[{"1", "-", 
             RowBox[{"s23var", "^", "2"}]}], ")"}]}], ")"}], "^", 
         RowBox[{"(", 
          RowBox[{"1", "/", "2"}], ")"}]}]}], ")"}]}]}], " ", "/.", " ", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"s23var", "->", 
       RowBox[{"s23sqvar", "^", 
        RowBox[{"(", 
         RowBox[{"1", "/", "2"}], ")"}]}]}], ",", 
      RowBox[{"s13var", "->", 
       RowBox[{"s13sqvar", "^", 
        RowBox[{"(", 
         RowBox[{"1", "/", "2"}], ")"}]}]}]}], "}"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"s12sqtm1", "[", "s13sqvar_", "]"}], ":=", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{"1", "-", 
      RowBox[{"3", "s13sqvar"}]}], ")"}], "/", 
    RowBox[{"(", 
     RowBox[{"3", "-", 
      RowBox[{"3", "s13sqvar"}]}], ")"}]}]}], ";"}]}], "Input",
 CellChangeTimes->{{3.9559072893817*^9, 3.955907293786936*^9}, {
  3.955907419463644*^9, 3.9559074759433203`*^9}, {3.955907559325725*^9, 
